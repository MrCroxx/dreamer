# All configuration stays on the backend. Never put secrets in VITE_* variables.
DREAMER_DATA_DIR=./data
DREAMER_LLM_BASE_URL=https://api.openai.com/v1
DREAMER_LLM_API_KEY=
DREAMER_LLM_MODEL=
# Optional bearer token. Required when exposing the app beyond localhost.
DREAMER_API_TOKEN=
# Add the exact origin here if you change the Vite development port.
DREAMER_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174"]
# Bambu Studio executable and FULL, flattened JSON presets exported for your printer.
DREAMER_SLICER_BIN=bambu-studio
DREAMER_MACHINE_PROFILE=
DREAMER_PROCESS_PROFILE=
DREAMER_FILAMENT_PROFILE=
DREAMER_BED_TYPE=Textured PEI Plate
# Community CLI: https://github.com/voska/bambu (not an official Bambu Lab CLI).
DREAMER_BAMBU_BIN=bambu
DREAMER_PRINTER_NAME=
DREAMER_FILAMENT_SLOT=A1
DREAMER_PRINT_ENABLED=false
# Set these to the usable dimensions of your actual printer, in millimeters.
DREAMER_BUILD_VOLUME=[180,180,180]
